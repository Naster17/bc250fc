#!/sbin/openrc-run
# OpenRC service for the bc250-fan-curve daemon (Alpine, Gentoo, ...)

name="bc250-fan-curve"
description="BC-250 temperature-based fan curve daemon"
command="/usr/local/bin/bc250-fan-curve"
command_background="yes"
pidfile="/run/bc250-fan-curve.pid"

start_pre() {
    mkdir -p /run/bc250-fan
    chmod 0755 /run/bc250-fan
}

depend() {
    after local
}
